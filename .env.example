# Dados de conexão do TiDB Cloud (pegue em: Cluster > Connect > Node.js)
TIDB_HOST=gateway01.XX-XXXXX.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=SEU_USUARIO.root
TIDB_PASSWORD=sua_senha_aqui
TIDB_DATABASE=painel

# Segredo usado para assinar os tokens JWT — gere um valor aleatório longo
# (ex: rode no terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque_por_um_valor_aleatorio_longo

# Por quanto tempo o login fica valido antes de precisar logar de novo
JWT_EXPIRES_IN=7d

# Porta em que a API vai rodar
PORT=3000

# URL(s) do painel web que podem chamar essa API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5500
